# Application
APP_NAME=Prime Role
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase / PostgreSQL
# Keep service-role keys and database credentials on the backend only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Vite exposes only variables prefixed with VITE_ to the browser.
# The publishable key is designed for browser use; never use the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Resume and job-search defaults
BASE_RESUME_PATH=
GENERATED_RESUME_DIR=generated-resumes
JOB_FETCH_CONCURRENCY=5

# AI-assisted matching and tailoring (optional until that feature is enabled)
OPENAI_API_KEY=
OPENAI_MODEL=
